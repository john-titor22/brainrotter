{
  "manifest_version": 3,
  "name": "Brainrotter",
  "version": "0.1.0",
  "description": "Open the Brainrotter dashboard and see the render queue at a glance.",
  "permissions": ["tabs", "storage", "alarms"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "action": {
    "default_title": "Brainrotter",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": { "service_worker": "background.js" }
}
