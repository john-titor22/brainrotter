# Vendored engine — keep the source, not its bulk or runtime state.
# resource/ (198MB of fonts + bgm) and test/ are restored by the clone in
# vendor/README.md, so they stay out of our repo.
vendor/MoneyPrinterTurbo/config.toml
vendor/MoneyPrinterTurbo/storage/
vendor/MoneyPrinterTurbo/models/
vendor/MoneyPrinterTurbo/.git/
vendor/MoneyPrinterTurbo/resource/*
!vendor/MoneyPrinterTurbo/resource/fonts/
vendor/MoneyPrinterTurbo/resource/fonts/*
!vendor/MoneyPrinterTurbo/resource/fonts/BeVietnamPro-Bold.ttf
vendor/MoneyPrinterTurbo/test/
vendor/MoneyPrinterTurbo/docs/
vendor/MoneyPrinterTurbo/*.lock

