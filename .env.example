# Copy to .env and fill in what you need. Brainrotter runs fully local by
# default (Ollama + edge-tts + yt-dlp), so none of these are required.

# Writer LLM. Local Ollama is the default (no key). To use a stronger model:
#  - writer.provider = "groq"  -> Groq free tier, Qwen3 27B, very fast,
#    ~14k requests/day, doesn't train on your data. Get a key (free):
#    https://console.groq.com/keys
GROQ_API_KEY=
#  - writer.provider = "anthropic"  -> Claude API (paid)
ANTHROPIC_API_KEY=

# Reddit API (free) — https://www.reddit.com/prefs/apps → "create app" →
# choose "script" → note the client id (under the app name) and the secret.
# Powers: (1) trend signals for the Director, (2) reliable clip sourcing for the
# "compilation" format. Without it: trends fall back to RSS/topic bank, and
# compilation falls back to Reddit's rate-limited RSS feeds + YouTube search.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=brainrotter/0.1 by u/yourname

# Optional: override the ffmpeg binary if it is not on PATH.
FFMPEG_BIN=ffmpeg

# --- Publishing (your own developer apps = unlimited) -----------------------
# Set the app creds, then run `brainrotter publish-auth <youtube|meta|tiktok>`
# once (opens the browser). Then [publish] enabled = true in config.toml.

# YouTube — console.cloud.google.com → enable "YouTube Data API v3" →
# OAuth client (Web app), redirect URI http://localhost:8721/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Instagram + Facebook — developers.facebook.com → Business app →
# Facebook Login + Instagram Graph API, redirect http://localhost:8721/callback
# (IG must be a Business/Creator account linked to a FB Page)
META_APP_ID=
META_APP_SECRET=

# TikTok — developers.tiktok.com → app → Login Kit + Content Posting API
# (posts are PRIVATE until TikTok audits your app)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Alternative: upload-post.com (one key, 10 uploads/mo free) instead of the above
UPLOAD_POST_API_KEY=
UPLOAD_POST_USER=
