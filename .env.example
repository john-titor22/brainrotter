# Copy to .env and fill in what you need. Brainrotter runs fully local by
# default (Ollama + edge-tts + yt-dlp), so none of these are required.

# Only if you set writer.provider = "anthropic" in config.toml:
ANTHROPIC_API_KEY=

# Optional: Reddit API for trend signals (https://www.reddit.com/prefs/apps).
# Without it, the Director uses the built-in topic bank.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=brainrotter/0.1 by u/yourname

# Optional: override the ffmpeg binary if it is not on PATH.
FFMPEG_BIN=ffmpeg
